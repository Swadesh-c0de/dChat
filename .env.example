# XMTP Network Environment ('dev' or 'production')
NEXT_PUBLIC_XMTP_ENV=dev

# WalletConnect Cloud Project ID (Get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id

# Pinata IPFS JWT (Get one at https://app.pinata.cloud/developers/api-keys)
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_token
